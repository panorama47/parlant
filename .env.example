# 环境变量配置文件示例
# 复制此文件为 .env 并填入实际值

# Flask配置
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-this

# Parlant服务器
PARLANT_SERVER_URL=http://parlant-server:8800
PARLANT_API_KEY=

# LLM API密钥
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=

# 数据库配置
PARLANT_DB_TYPE=mongodb
DATABASE_URL=mongodb://parlant:parlant123@mongodb:27017/parlant

# MongoDB配置
MONGO_PASSWORD=parlant123

# 向量数据库
QDRANT_URL=http://qdrant:6333

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/flask_app.log

# CORS配置
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Gunicorn配置
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
